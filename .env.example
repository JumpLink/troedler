# Troedler — provider credentials.
#
# Every one of these is OPTIONAL. A provider without its credentials reports
# itself "not configured" and is skipped; it never fails a search silently.
# Copy to `.env` (gitignored) or export them in your shell.

# ─── eBay ─────────────────────────────────────────────────────────────────
# developer.ebay.com → Application Keys → Production keyset. Free, no waiting.
# Before your first PRODUCTION call you must either subscribe to eBay's
# marketplace account deletion notifications or opt out of them — troedler
# stores no eBay user data, so opting out is the correct choice here.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_DE

# ─── Discogs ──────────────────────────────────────────────────────────────
# Works WITHOUT a token at 25 requests/minute. A personal access token from
# discogs.com/settings/developers raises it to 60.
DISCOGS_TOKEN=

# ─── Booklooker ───────────────────────────────────────────────────────────
# Free API key from booklooker.de (Verkäufer-Menü → API).
BOOKLOOKER_API_KEY=

# ─── Booklooker: optional narrowing ───────────────────────────────────────
# BOOKLOOKER_MEDIUM=Buch
# BOOKLOOKER_SHIPPING_COUNTRY=DE

# ─── Sources that are OFF by default ──────────────────────────────────────
# kleinanzeigen.de and markt.de forbid automated access in their terms of use.
# There is no environment variable that switches them on, deliberately: read
# the source record, then say so on the record.
#
#   troedler providers show kleinanzeigen
#   troedler providers enable kleinanzeigen --acknowledge
#
# The acknowledgement date lands in $XDG_CONFIG_HOME/troedler/config.json.

# ─── Optional per-source defaults ─────────────────────────────────────────
# Narrow a source to one category or place. Useful where a portal's site-wide
# search wanders off into partner listings after page one.
# TROEDLER_KLEINANZEIGEN_CATEGORY=fahrraeder
# TROEDLER_KLEINANZEIGEN_LOCATION=hamburg
# TROEDLER_MARKT_CATEGORY=haus-garten
# TROEDLER_MARKT_REGION=
# TROEDLER_QUOKA_CATEGORY=

# ─── Testing only ─────────────────────────────────────────────────────────
# eBay sandbox host. Accepts only api.ebay.com and api.sandbox.ebay.com —
# `apiHost: true` disables the robots gate for this host, so a free-form value
# would point a keyset at an unlicensed host with the gate switched off.
# EBAY_API_HOST=api.sandbox.ebay.com
